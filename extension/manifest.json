{
  "manifest_version": 3,
  "name": "CashTab — твой рабочий стол",
  "version": "1.0.1",
  "description": "Новая вкладка в стиле настольного Mac: док, приложения, заметки и свои обои.",
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "icons": { "16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'self';" }
}
